# ============================================================
# ConnectSphere — Root Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ─────────────────────────────────────────────────
# Use "localhost" when running the backend on your host (npm run dev).
# Use the Docker service name "mongo" only if the backend ITSELF also
# runs inside docker-compose.
MONGO_URI=mongodb://localhost:27017/connectsphere

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ───────────────────────────────────────────────────
# Host-based backend → localhost:9092 (PLAINTEXT_HOST listener).
# Backend running inside Docker → kafka:9093 (PLAINTEXT listener).
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=connectsphere-backend

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── AWS S3 (for recordings & snapshots) ────────────────────
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
S3_BUCKET_NAME=connectsphere-media

# ── Email / SMTP ────────────────────────────────────────────
# Dev: points at the MailDev container (docker-compose) — catches all mail,
#      view it at http://localhost:1080. Nothing leaves your machine.
# Prod: swap these for a real provider (Resend, Brevo, etc.).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ConnectSphere <no-reply@connectsphere.local>"

# ── Web Push (VAPID) ────────────────────────────────────────
# Free — the keys are just a locally generated keypair, no provider account.
# Generate once:  npx web-push generate-vapid-keys
# Leave empty to disable push (everything else keeps working).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@connectsphere.local

# ── LibreTranslate (live caption translation) ───────────────
# Free, self-hosted MT — run it via docker compose:
#   docker compose up -d libretranslate     (first start downloads models)
# Leave empty to disable translation (captions still work untranslated).
LIBRETRANSLATE_URL=http://localhost:5050
LIBRETRANSLATE_API_KEY=

# ── URLs (used to build links inside emails) ────────────────
SERVER_URL=http://localhost:5000
# Frontend URL (also used for CORS)
CLIENT_URL=http://localhost:3000

# NOTE - frontend env lives separately (see frontend/.env.example).
# The chat GIF picker uses KLIPY's free tier, and that key is a CLIENT key
# (it ships inside the JS bundle), so it belongs in frontend/.env as
# VITE_KLIPY_KEY - not here. Without it the GIF tab still works: it falls back
# to OtakuGIFs (keyless) and then to built-in animated cards.
# (Tenor was the original choice; Google is shutting that API down on
# 30 Jun 2026 and stopped issuing keys in Jan 2026.)
