# ============================================================
# ConnectSphere — Frontend environment (Vite)
#
# Copy to `.env` and fill in what you need:
#   cp .env.example .env
#
# IMPORTANT: every VITE_* variable is embedded into the JavaScript bundle and
# is therefore PUBLIC. Never put a secret here — only keys that are meant to
# be client-visible (like a GIF search key scoped to search).
# ============================================================

# ── Tenor GIF search (chat GIF picker) ──────────────────────────
# Free — no billing account needed. Get a key at:
#   https://developers.google.com/tenor/guides/quickstart
# (create a Google Cloud project → enable "Tenor API" → create an API key)
#
# Leave empty and the GIF tab still works: it falls back to a small curated
# set of reaction GIFs, same graceful-degradation rule the backend uses for
# S3 / OAuth / push. Search only reaches Tenor when a key is present.
VITE_TENOR_KEY=
