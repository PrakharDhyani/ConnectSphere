# ============================================================
# Groot — production environment TEMPLATE.
#
#   cp .env.production.example .env.production   (on the server)
#   then fill in every <...> value.
#
# .env.production is read by docker-compose.prod.yml (compose
# variables like ${DOMAIN}) AND injected into the backend
# container via env_file. NEVER commit the filled-in file.
# ============================================================

# ── Identity ──
# The public hostname (no protocol). Caddy gets its TLS cert for this.
DOMAIN=<your-domain, e.g. groot.duckdns.org>
SERVER_URL=https://<your-domain>
CLIENT_URL=https://<your-domain>

NODE_ENV=production
PORT=5000

# ── Data stores (compose service names, not localhost) ──
MONGO_URI=mongodb://mongo:27017/groot
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=groot-backend

# ── Auth secrets — generate fresh ones, 64+ hex chars each:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<generate>
JWT_REFRESH_SECRET=<generate>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth (console.cloud.google.com → add the prod redirect URI) ──
GOOGLE_CLIENT_ID=<from google console>
GOOGLE_CLIENT_SECRET=<from google console>
GOOGLE_CALLBACK_URL=https://<your-domain>/api/auth/google/callback

# ── Object storage (MinIO inside the stack) ──
# S3_PUBLIC_URL rides the main domain under /s3 (see deploy/Caddyfile),
# so avatars load over the same HTTPS origin.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=<generate a user, e.g. 20 random chars>
S3_SECRET_KEY=<generate a password, 40+ random chars>
S3_BUCKET=avatars
S3_REGION=us-east-1
S3_PUBLIC_URL=https://<your-domain>/s3

# ── Email — Resend free tier (100/day): https://resend.com ──
# SMTP creds from the Resend dashboard; EMAIL_FROM must be a sender/domain
# verified there ("onboarding@resend.dev" works for testing).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=<resend API key>
EMAIL_FROM=Groot <onboarding@resend.dev>

# ── mediasoup (video calls) ──
# The VM's PUBLIC IP — WebRTC clients connect to this address directly.
MEDIASOUP_ANNOUNCED_IP=<vm public ip>
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
